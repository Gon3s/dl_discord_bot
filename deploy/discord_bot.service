[Unit]
Description=dl_discord_bot — Bot Discord thin client
After=network.target dl_backend.service
Requires=dl_backend.service

[Service]
Type=simple
User=gones
WorkingDirectory=/home/gones/Project/python/dl_discord_bot/bot
EnvironmentFile=/home/gones/Project/python/dl_discord_bot/.env
ExecStart=/home/gones/.local/bin/uv run python main.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
