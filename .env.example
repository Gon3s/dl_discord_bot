# Discord
DISCORD_TOKEN=your_discord_bot_token
DISCORD_GUILD=your_discord_server_id

# Debrid provider
DEBRID_PROVIDER=alldebrid
ALLDEBRID_API_KEY=your_alldebrid_api_key
REALDEBRID_API_TOKEN=your_realdebrid_api_token

# Paths & URLs
DOWNLOAD_PATH=/data/media
WAWACITY_URL=https://www.wawacity.city/
1337X_URL=https://1337x.to
BACKEND_URL=http://localhost:8000

# DarkiWorld
DARKIWORLD_URL=https://darkiworld16.com
DARKIWORLD_EMAIL=your_email@example.com
DARKIWORLD_PASSWORD=your_password

# Database
DATABASE_URL=sqlite+aiosqlite:///./dl_bot.db

# Download queue
MAX_CONCURRENT_DOWNLOADS=2

# Selenium / dl-protect
SELENIUM_BINARY_LOCATION=
